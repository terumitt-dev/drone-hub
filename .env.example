# Drone サーバ設定
DRONE_SERVER_HOST=drone.example.com   # 公開ホスト名 (Cloudflare Tunnel の Public Hostname)
DRONE_SERVER_PROTO=https               # Cloudflare 側で TLS 終端するため https のまま

# GitHub OAuth
DRONE_GITHUB_CLIENT_ID=your_client_id
DRONE_GITHUB_CLIENT_SECRET=your_client_secret

# Drone Runner とサーバ間のシークレット
DRONE_RPC_SECRET=generate_with_openssl_or_random_hex

# 管理者 GitHub ユーザー名
DRONE_ADMIN=your-github-username

# Cloudflare Tunnel トークン
# Zero Trust → Networks → Tunnels で Tunnel 作成時に発行されるトークンを貼る
CLOUDFLARE_TUNNEL_TOKEN=eyJh...
